{
  "name": "cph-pi",
  "version": "0.1.0",
  "description": "基于 Pi 极简防臃肿基座的 Microsoft Copilot 自主编程 Agent Harness",
  "type": "module",
  "scripts": {
    "start": "bun run src/cli.ts",
    "web": "bun run src/cli.ts web",
    "web:dev": "cd web && bun run dev",
    "web:build": "cd web && bun run build",
    "build:all": "bun run web:build && bun run build:package",
    "check:accounts": "bun run scripts/probe-agent-access.ts",
    "check:accounts:apply": "bun run scripts/probe-agent-access.ts --apply",
    "package": "bun run scripts/package-agent-bundle.ts",
    "build:package": "bun build src/cli.ts --target node --outfile package/bin/cph-pi.js && bun build scripts/probe-agent-access.ts --target node --outfile package/bin/check-accounts.js",
    "test": "bun test tests/",
    "sync:prewarm": "bun run src/workspace/pnp-sync-cli.ts --action prewarm",
    "sync:reset": "bun run src/workspace/pnp-sync-cli.ts --action prewarm --hard-reset",
    "sync:file": "bun run src/workspace/pnp-sync-cli.ts --action sync-file"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "diff": "^7.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/diff": "^5.2.3",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13"
  }
}
